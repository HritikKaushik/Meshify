{
	"name": "meshify-ai-platform",
	"private": true,
	"version": "0.1.0",
	"packageManager": "pnpm@9.12.0",
	"scripts": {
		"build": "turbo run build",
		"typecheck": "turbo run typecheck",
		"test": "turbo run test",
		"test:coverage": "vitest run --coverage",
		"test:watch": "vitest",
		"test:integration": "turbo run test:integration",
		"test:e2e": "turbo run test:e2e",
		"lint": "turbo run lint",
		"predev": "node scripts/sync-rocketride-port.mjs",
		"dev": "turbo run dev",
		"sync:rocketride": "node scripts/sync-rocketride-port.mjs",
		"dev:api": "pnpm --filter @meshify/platform-api dev",
		"dev:bff": "pnpm --filter @meshify/bff dev",
		"dev:worker": "pnpm --filter @meshify/worker dev",
		"dev:web": "pnpm --filter @meshify/web dev",
		"migrate": "pnpm --filter @meshify/data-access migrate"
	},
	"devDependencies": {
		"@meshify/testing": "workspace:*",
		"@vitest/coverage-v8": "^3.2.6",
		"turbo": "^2.3.3",
		"vitest": "^3.2.6"
	},
	"pnpm": {
		"overrides": {
			"ioredis": "5.11.1",
			"adm-zip": "^0.6.0"
		}
	}
}
