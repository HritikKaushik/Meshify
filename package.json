{
	"name": "meshify-ai-platform",
	"private": true,
	"version": "0.1.0",
	"packageManager": "pnpm@9.12.0",
	"scripts": {
		"build": "turbo run build",
		"typecheck": "turbo run typecheck",
		"test": "turbo run test",
		"lint": "turbo run lint",
		"dev:api": "pnpm --filter @meshify/platform-api dev",
		"dev:worker": "pnpm --filter @meshify/worker dev",
		"migrate": "pnpm --filter @meshify/data-access migrate"
	},
	"devDependencies": {
		"turbo": "^2.3.3",
		"vitest": "^2.1.8"
	},
	"pnpm": {
		"overrides": {
			"ioredis": "5.11.1"
		}
	}
}
