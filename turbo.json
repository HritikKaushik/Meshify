{
	"$schema": "https://turbo.build/schema.json",
	"tasks": {
		"dev": {
			"cache": false,
			"persistent": true
		},
		"build": {
			"dependsOn": ["^build"],
			"outputs": ["dist/**"]
		},
		"typecheck": {
			"dependsOn": ["^build"]
		},
		"test": {
			"dependsOn": ["^build"],
			"inputs": ["src/**", "tests/**", "vitest.config.*", "package.json", "tsconfig.json"],
			"outputs": []
		},
		"test:integration": {
			"dependsOn": ["^build"],
			"cache": false
		},
		"test:e2e": {
			"dependsOn": ["^build"],
			"cache": false
		},
		"lint": {}
	}
}
