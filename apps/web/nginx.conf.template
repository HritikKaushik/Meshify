# Rendered at container start by the nginx image's envsubst entrypoint: only real
# env vars (BFF_UPSTREAM, PORT, NGINX_LOCAL_RESOLVERS) are substituted; nginx's own
# $uri/$host/$request_uri are preserved (they are not in the environment). PORT
# defaults to 8080 (Dockerfile ENV) but is overridden by the value the host injects
# — Railway assigns a $PORT for public services and routes to it.
#
# The /api upstream is resolved at REQUEST time (resolver + a variable in
# proxy_pass), not at boot: a static target makes nginx refuse to start if the BFF
# name is briefly unresolvable — the norm on platforms with dynamic internal DNS
# (Railway `*.railway.internal`, a not-yet-deployed BFF, a rolling restart).
#
# NOTE on headers: nginx `add_header` does NOT inherit into a location that sets
# its own add_header — it replaces the whole set. Because `/` internally redirects
# to `= /index.html` via try_files, the security headers must be repeated in every
# location that also sets a Cache-Control header, or the app HTML would ship with
# none. They are grouped below for that reason.
server {
    listen ${PORT};
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # Applies to /api/ and any location WITHOUT its own add_header.
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;

    # Entry HTML: never cached, so new deploys are picked up immediately.
    location = /index.html {
        add_header Cache-Control "no-cache" always;
        add_header X-Content-Type-Options nosniff always;
        add_header X-Frame-Options DENY always;
        add_header Referrer-Policy strict-origin-when-cross-origin always;
    }

    # Hash-named build assets are immutable — cache them hard.
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        add_header X-Content-Type-Options nosniff always;
        add_header X-Frame-Options DENY always;
        add_header Referrer-Policy strict-origin-when-cross-origin always;
        try_files $uri =404;
    }

    # Single-origin bridge: the browser only ever talks to THIS origin. Anything
    # under /api is streamed to the Clerk-authenticated BFF, so there is no CORS
    # surface and the browser never holds a platform-api or provider credential.
    location /api/ {
        # Request-time resolution (see header note). NGINX_LOCAL_RESOLVERS is set by
        # the image entrypoint from /etc/resolv.conf — Railway internal DNS, Docker's
        # 127.0.0.11, or kube-dns, whichever the platform provides. `valid=10s`
        # re-resolves as the BFF's private IP changes across deploys; ipv6 is on by
        # default, which Railway's IPv6 private network needs.
        resolver ${NGINX_LOCAL_RESOLVERS} valid=10s;
        set $bff_upstream ${BFF_UPSTREAM};
        # $request_uri = the full original path+query (e.g. /api/v1/x?y), so the /api
        # prefix is preserved exactly as the static target did — no prefix stripping.
        proxy_pass $bff_upstream$request_uri;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # Server-Sent Events (job-progress / integration streams) must not buffer.
        proxy_set_header Connection '';
        proxy_buffering off;
        proxy_read_timeout 3600s;
        # Uploads can be large; the ingress/CDN in front may cap this too.
        client_max_body_size 50m;
        # The BFF (helmet) also sets these; strip the upstream copies so the client
        # sees exactly one, from this server block's add_header (inherited here).
        proxy_hide_header X-Frame-Options;
        proxy_hide_header X-Content-Type-Options;
        proxy_hide_header Referrer-Policy;
    }

    # SPA fallback: client-side routes resolve to index.html.
    location / {
        try_files $uri $uri/ /index.html;
    }
}
