{
  "components": [
    {
      "id": "webhook_1",
      "provider": "webhook",
      "config": {
        "hideForm": true,
        "mode": "Source",
        "parameters": {},
        "type": "webhook"
      }
    },
    {
      "id": "parse_1",
      "provider": "parse",
      "config": {},
      "input": [
        {
          "lane": "tags",
          "from": "webhook_1"
        }
      ]
    },
    {
      "id": "preprocessor_langchain_1",
      "provider": "preprocessor_langchain",
      "config": {
        "profile": "default",
        "default": {
          "mode": "strlen",
          "strlen": 768,
          "splitter": "RecursiveCharacterTextSplitter"
        },
        "parameters": {}
      },
      "input": [
        {
          "lane": "text",
          "from": "parse_1"
        }
      ]
    },
    {
      "id": "embedding_1",
      "provider": "embedding_openai",
      "config": {
        "profile": "text-embedding-3-large",
        "text-embedding-3-large": {
          "apikey": "${ROCKETRIDE_OPENAI_KEY}"
        },
        "parameters": {}
      },
      "input": [
        {
          "lane": "documents",
          "from": "preprocessor_langchain_1"
        }
      ]
    },
    {
      "id": "qdrant_1",
      "provider": "qdrant",
      "config": {
        "profile": "cloud",
        "cloud": {
          "host": "${ROCKETRIDE_QDRANT_HOST}",
          "port": 6333,
          "collection": "proj_SAMPLE_documents",
          "score": 0.4,
          "apikey": "${ROCKETRIDE_QDRANT_APIKEY}",
          "serverName": "qdrant_1"
        },
        "parameters": {}
      },
      "input": [
        {
          "lane": "documents",
          "from": "embedding_1"
        }
      ]
    }
  ],
  "source": "webhook_1",
  "project_id": "21b1910f-26b3-4e28-8ac9-1c94808929ef",
  "viewport": {
    "x": 0,
    "y": 0,
    "zoom": 1
  },
  "version": 1
}
