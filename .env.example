# Copy to .env and fill in real values. Never commit .env.
NODE_ENV=development

# Platform API
PLATFORM_PORT=3000
# Also read by apps/bff (auto-provisions API keys for new Clerk orgs) — must
# be the SAME value in both processes' env, or platform-api can never verify
# a key the BFF minted.
# Generate a real value: `openssl rand -base64 32`. Placeholder/low-entropy values
# are REJECTED at boot when NODE_ENV=production.
PLATFORM_API_KEY_PEPPER=change-me-to-a-random-32-char-string
PLATFORM_LOG_LEVEL=info
# Gates the Prometheus /metrics endpoint (scraper sends it as a bearer token). At least
# 16 chars; REQUIRED in production. Leave empty in dev to keep /metrics open. See docs/operations/OBSERVABILITY.md.
METRICS_TOKEN=
# OpenTelemetry tracing (platform-api/bff/worker). Optional — leave the endpoint
# empty to disable (zero cost). Set it to an OTLP/HTTP collector to enable, and set
# OTEL_SERVICE_NAME per service so spans are attributed correctly.
OTEL_EXPORTER_OTLP_ENDPOINT=
# OTEL_SERVICE_NAME=platform-api   # set per process (each app should override)
# Per-API-key rate limit (fixed window). Defaults: 120 requests / 60s.
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW_SEC=60
RATE_LIMIT_KEY_MAX=1200
# Daily retention sweeps (worker): pipeline run traces and audit log entries older than this are deleted
PIPELINE_RUN_RETENTION_DAYS=30
AUDIT_LOG_RETENTION_DAYS=365
# Chat retrieval floor: chunks below this cosine similarity are never used as context
RAG_MIN_SCORE=0.25
# Postgres pool per process (keep services x replicas x PG_POOL_MAX under the database's connection limit)
PG_POOL_MAX=10
PG_STATEMENT_TIMEOUT_MS=30000
# Trusted proxy hops for X-Forwarded-For (platform-api: the BFF = 1; BFF behind nginx + a load balancer = 2)
TRUST_PROXY_HOPS=1

# BFF (Clerk session proxy, apps/bff) — Clerk protects this app; it holds each
# org's msk_ key server-side and proxies authenticated browser calls to
# platform-api. The browser never sees the raw API key.
BFF_PORT=3001
# Where the BFF reaches platform-api: a full URL, or a bare host:port (defaulted to
# http://) - the form a Render Blueprint `fromService: hostport` reference yields.
PLATFORM_API_ORIGIN=http://localhost:3000
# Public origin(s) the browser loads the web app from — the BFF's CSRF guard
# rejects any state-changing request whose Origin isn't in this list. Comma-separate
# multiple. REQUIRED in production; in dev the BFF defaults to the Vite origin below.
APP_ORIGIN=http://localhost:5174
CLERK_SECRET_KEY=sk_test_your-clerk-secret-key
CLERK_PUBLISHABLE_KEY=pk_test_your-clerk-publishable-key
# Encrypts each auto-provisioned org's API key at rest in clerk_org_links.
# Generate: `openssl rand -base64 32`. Placeholder values are rejected in production.
ORG_KEY_ENCRYPTION_KEY=change-me-to-a-random-32-byte-key

# Web (Vite — only VITE_-prefixed vars are exposed to the browser bundle)
VITE_CLERK_PUBLISHABLE_KEY=pk_test_your-clerk-publishable-key
# Dev-only: where Vite's /api proxy forwards (the BFF). Defaults to this if unset;
# set it to test the SPA against a remote/deployed BFF. Not used in production
# (there the web container's nginx proxies /api to the BFF instead).
BFF_ORIGIN=http://localhost:3001

# Postgres
DATABASE_URL=postgres://meshify:meshify@localhost:5432/meshify

# Redis / BullMQ
REDIS_URL=redis://localhost:6379

# Qdrant
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# S3-compatible object storage (MinIO locally; swap endpoint/creds for Backblaze B2/S3/Spaces in prod)
# Backblaze B2 prod example:
#   S3_ENDPOINT=https://s3.us-west-004.backblazeb2.com   (must match the bucket's region)
#   S3_REGION=us-west-004                                (the real region; NOT "auto")
#   S3_ACCESS_KEY_ID=<B2 application keyID>
#   S3_SECRET_ACCESS_KEY=<B2 applicationKey>
#   S3_FORCE_PATH_STYLE=false
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=meshify-documents
S3_ACCESS_KEY_ID=meshify
S3_SECRET_ACCESS_KEY=meshify123
S3_FORCE_PATH_STYLE=true

# RocketRide (auto-managed by the VS Code extension in dev; set manually in prod)
ROCKETRIDE_URI=http://localhost:5565
ROCKETRIDE_APIKEY=your-rocketride-api-key

# LLM / embedding provider keys, injected into pipeline profiles as ${ROCKETRIDE_*}
ROCKETRIDE_OPENAI_KEY=your-openai-api-key
ROCKETRIDE_GEMINI_KEY=your-gemini-api-key

# Meshify's managed GitHub App — operator-level config, set ONCE per
# deployment (customers never create apps; their orgs install this one via
# Connect GitHub). All optional: without them the github provider reports
# "not configured" (503) and everything else still runs.
GITHUB_APP_ID=your-github-app-id
GITHUB_APP_PRIVATE_KEY=your-github-app-private-key
GITHUB_APP_WEBHOOK_SECRET=your-github-app-webhook-secret
# The app's slug (github.com/apps/<slug>) — builds the Connect GitHub install URL.
GITHUB_APP_SLUG=your-github-app-slug
# GitHub App user-authorization OAuth — REQUIRED for a secure connect flow: verifies
# the connecting user actually controls the installation (enable "Request user
# authorization (OAuth) during installation" on the App). Without these the github
# provider reports "not configured" and refuses to connect.
GITHUB_APP_CLIENT_ID=your-github-app-client-id
GITHUB_APP_CLIENT_SECRET=your-github-app-client-secret

# Encrypts integration credentials at rest (CredentialVault). Optional — falls
# back to ORG_KEY_ENCRYPTION_KEY; set separately to decouple key rotation.
INTEGRATION_ENCRYPTION_KEY=

# Slack connector (conversation ingestion). Optional — leave blank to disable the
# Slack knowledge source. SLACK_REDIRECT_URI must be a static URL registered on
# the Slack app that points at the web app's /oauth/slack/callback route. OAuth
# state signing + access-token encryption reuse ORG_KEY_ENCRYPTION_KEY.
SLACK_CLIENT_ID=id
SLACK_CLIENT_SECRET=client-secret
SLACK_REDIRECT_URI=http://localhost:5174/oauth/slack/callback
# Verifies Slack Events API request signatures; also required for the
# provider-platform Slack integration surface (org-level connects).
SLACK_SIGNING_SECRET=signing-secret
